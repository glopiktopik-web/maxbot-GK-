# Токен бота MAX (получить в @MasterBot)
MAX_BOT_TOKEN=

# Папка с фотографиями расписаний.
# По умолчанию — соседняя папка schedules рядом с max_bot.
# SCHEDULES_DIR=C:\Users\Admin\Desktop\konkurs\schedules

# ID администраторов через запятую — им доступна рассылка объявлений.
# Свой ID покажет команда /id в боте.
ADMIN_IDS=

# Название организации — подставляется в шаблоны документов
ORG_NAME=
